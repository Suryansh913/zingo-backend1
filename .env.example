
# ================= ZINGO backend environment =================
# Placeholders only - never commit real secrets.

DJANGO_SECRET_KEY=generate-with-get_random_secret_key
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=zingo-backend-o11v.onrender.com
CORS_ALLOWED_ORIGINS=https://zingo-frontend.onrender.com
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://user:password@host:5432/dbname
RUN_MIGRATIONS=1

# ---- Media storage: Cloudinary ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: persistent local disk fallback
# MEDIA_ROOT=/var/data/media
SERVE_LOCAL_MEDIA=1
MAX_VIDEO_MB=100

# ---- Redis ----
REDIS_URL=

# ---- ZINGO Match ----
MATCH_LAUNCH_STATE=restricted
MATCH_REQUIRE_VERIFIED_AGE=0
MATCH_MODERATION_CONFIRMED=0
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_SHARED_SECRET=change-me
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Optional tuning:
# MATCH_QUEUE_TTL=60
# MATCH_ACCEPT_SECONDS=20
# MATCH_DISCONNECT_GRACE=30
# MATCH_COOLDOWN_MINUTES=10
# MATCH_MAX_SESSIONS_PER_HOUR=60
# MATCH_AUTO_RESTRICT_REPORTS=3

# ---- Frontend (frontend/.env) ----
# VITE_API_URL=https://zingo-backend-o11v.onrender.com

# ---- ZINGO Date (18+) ----
DATE_LAUNCH_STATE=restricted
DATE_REQUIRE_VERIFIED_AGE=0
DATE_MODERATION_CONFIRMED=0
# Optional tuning:
# DATE_MAX_LIKES_PER_DAY=100
# DATE_AUTO_HOLD_REPORTS=3
